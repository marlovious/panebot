{
  "manifest_version": 3,
  "name": "PaneBot",
  "version": "0.1.0",
  "description": "Send URLs to PaneBot panes",
  "permissions": ["activeTab", "contextMenus", "storage", "clipboardRead", "tabs"],
  "host_permissions": [
    "wss://127.0.0.1:9090/",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PaneBot"
  }
}
